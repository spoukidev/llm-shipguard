# Copy to .env (never commit .env). Provider keys live only in the gateway's environment.
SHIPGUARD_POLICY=config/policy.yaml
SHIPGUARD_UPSTREAM=mock            # mock | mock-http | openai | anthropic | openrouter | vllm | ollama
SHIPGUARD_AUDIT_DB=sqlite:///./data/audit.db
SHIPGUARD_CANARY_SECRET=change-me
SHIPGUARD_API_KEYS=                # optional comma-separated client keys; empty = no client auth
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
